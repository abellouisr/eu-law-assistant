# Copy this file to .env and fill in the key. Never commit .env.
ANTHROPIC_API_KEY=

# Optional settings
# NLI_MODEL=claude-sonnet-5-5
# NLI_EFFORT=low
# NLI_USAGE_RETENTION_DAYS=90
# NLI_USAGE_LOG=on
# NLI_LIVE_CHECK=on
# NLI_LIVE_CHECK_HOURS=24
# NLI_DOCUMENT=eecc
# NLI_TOP_K=8

# Where Claude runs: anthropic (default), bedrock or foundry
# NLI_PROVIDER=anthropic
# Amazon Bedrock: AWS credentials from your profile, environment or role
# NLI_AWS_REGION=eu-central-1
# NLI_BEDROCK_MODEL=eu.anthropic.claude-sonnet-5-5   (optional inference profile id)
# Microsoft Foundry
# ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
# ANTHROPIC_FOUNDRY_API_KEY=...
# NLI_FOUNDRY_AUTH=key            (or entra: sign in with Entra ID, needs azure-identity)
# NLI_FOUNDRY_DEPLOYMENT=claude-sonnet-5-5
# NLI_FOUNDRY_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# Suggesting another act in the library
# NLI_SUGGEST_MIN_SCORE=10
# NLI_SUGGEST_RATIO=1.5
