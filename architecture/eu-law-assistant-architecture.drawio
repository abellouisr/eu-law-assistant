olor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="queries ↔ passages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="c17" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="690"/><mxPoint x="445" y="690"/></Array></mxGeometry></mxCell><mxCell id="c40" value="Governance &amp; operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="1170" y="80" width="270" height="890" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Immutable audit log&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; every request and answer&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; SIEM; tamper-evident, retention by policy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="115" width="246" height="105" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Usage &amp; quality dashboards&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; logs, evaluation scores&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; adoption, accuracy, cost per team" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="235" width="246" height="105" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Privacy &amp; compliance&lt;/b&gt;&lt;br&gt;DPIA, data residency, ISO 27001 / SOC 2 controls, EU AI Act transparency duties" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="355" width="246" height="105" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Content ownership&lt;/b&gt;&lt;br&gt;named owner per act; translations and scope reviewed by legal experts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="475" width="246" height="105" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Professional risk&lt;/b&gt;&lt;br&gt;“reference, not advice” positioning agreed with risk &amp; quality; human review of client deliverables" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="595" width="246" height="105" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Cost &amp; capacity&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; usage per team&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; budgets, quotas, alerts; prompt-caching savings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="715" width="246" height="105" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Release management&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; prompt, model or search change&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; evaluation gate before release; one-click rollback" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="835" width="246" height="105" as="geometry"/></mxCell><mxCell id="c48" value="Feasibility &amp; roadmap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="1460" y="80" width="300" height="890" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Foundation is proven.&lt;/b&gt; Grounded answers with verified quotations, 24 languages, automatic updates, 3 acts, Bedrock/Foundry-ready: the core approach works." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#E8F5E9;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1472" y="112" width="276" height="84" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Biggest technical gap.&lt;/b&gt; Search and answers across hundreds of acts: hybrid search, multi-act answers, law as at a date." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1472" y="204" width="276" height="84" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Decisive for a Big 4 firm.&lt;/b&gt; Confidential client facts will be typed in: run in the firm's tenant, SSO, audit, zero-retention terms." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1472" y="296" width="276" height="84" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Sign-off needs numbers.&lt;/b&gt; Measured accuracy per act (evaluation suite) before risk &amp; quality functions approve." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1472" y="388" width="276" height="84" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Prototype · done&lt;/b&gt;&lt;br&gt;3 acts, verified quotations, 24 languages, cross-act suggestions with return to the home act, password-protected test on Streamlit Community Cloud, live updates, usage &amp; topics logs, professional UI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1472" y="500" width="276" height="120" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Pilot · ~3–4 months&lt;/b&gt;&lt;br&gt;5–10 acts for one practice group; SSO; firm cloud; evaluation suite; Teams plug-in. 2–3 engineers + legal expert part-time" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" parent="1"><mxGeometry x="1472" y="650" width="276" height="120" as="geometry"/></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Production · ~9–12+ months&lt;/b&gt;&lt;br&gt;hundreds of acts; hybrid search; multi-act answers; law as at a date; full compliance; dedicated product team" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" parent="1"><mxGeometry x="1472" y="800" width="276" height="120" as="geometry"/></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c54" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="Effort figures are indicative and depend on the firm's existing platform." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#757575;" vertex="1" parent="1"><mxGeometry x="1472" y="932" width="276" height="30" as="geometry"/></mxCell><mxCell id="c59" value="User-friendliness in the target design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="995" width="1740" height="75" as="geometry"/></mxCell><mxCell id="c60" value="Ask from Teams or the firm's AI platform: no new tool to learn" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="32" y="1025" width="330" height="36" as="geometry"/></mxCell><mxCell id="c61" value="Single sign-on: no extra password" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="377" y="1025" width="330" height="36" as="geometry"/></mxCell><mxCell id="c62" value="“As at” date selector for historic law" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="722" y="1025" width="330" height="36" as="geometry"/></mxCell><mxCell id="c63" value="Answers across several acts, each citation verified" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1067" y="1025" width="330" height="36" as="geometry"/></mxCell><mxCell id="c64" value="Same plain-summary-first answers, in 24 languages" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1412" y="1025" width="330" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flows" name="3 · Language, act switch and return"><mxGraphModel dx="1780" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="840" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="EU LexRef — conversation flows: language, change of act, return to the Code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#212121;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1700" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Each step with what goes in and what comes out · colours show which component does the step (see page 1) · the Code (Directive (EU) 2018/1972) is the home act" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1700" height="20" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1740" height="172" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;A · Language&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;The page, the answers and the quotations follow the language the user writes in.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#BDBDBD;" vertex="1" parent="1"><mxGeometry x="32" y="94" width="146" height="144" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;A1 · Page opens · app.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; browser language (e.g. de-DE)&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; page texts, notices, examples and act names in German, if the act is loaded in German; otherwise English&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;dropdown drawn for this language&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="190" y="108" width="246" height="128" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;A2 · Analyse · model call&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; question typed in Estonian&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; language code et and its name; the act's name in Estonian; English search queries" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="452" y="108" width="246" height="128" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;A3 · Session &amp; Localiser · i18n.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; language et&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; session language set to et; wording read from data/i18n/et.json; missing entries translated once and saved" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="714" y="108" width="246" height="128" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;A4 · Retrieve · Estonian text&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; English search queries&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; the same provisions from the Estonian text; English with a note if a provision is missing in Estonian" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="976" y="108" width="246" height="128" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;A5 · Answer &amp; verify&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; Estonian passages&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; summary and explanation in Estonian; quotations checked against the Estonian text; links to the Estonian EUR-Lex page" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1238" y="108" width="246" height="128" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;A6 · Page redraw&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; reply in Estonian&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; page, sidebar and act names in Estonian; a new dropdown for et keeps the selected act; “Open the official text” links to the Estonian version" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1500" y="108" width="246" height="128" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="268" width="1740" height="172" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;B · Change of act&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;A question that belongs to another act in the library.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#BDBDBD;" vertex="1" parent="1"><mxGeometry x="32" y="282" width="146" height="144" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;B1 · Analyse · model call&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; GDPR fines question asked while the Code is selected&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; in scope: no; act that covers it: gdpr (judged by subject, not shared words); search queries" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="190" y="296" width="246" height="128" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;B2 · Route · library.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; search queries; act named in B1&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; suggestion when the named act also scores ≥ 10 in the shared keyword index: act, best provisions (labels in the user's language), original question&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;after a full answer: other act must score 1.5 × the selected one&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="452" y="296" width="246" height="128" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;B3 · Reply in the Code&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; suggestion&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; “The selected act does not deal with this question, but another act in this library does”; matching provisions; button “Switch to GDPR and ask there”&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;nothing recorded: the library has it&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="714" y="296" width="246" height="128" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;B4 · User clicks Switch&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; act id + original question&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; dropdown set to the GDPR; question queued; language carried over; conversation kept on screen; note “Now answering from: GDPR”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="976" y="296" width="246" height="128" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;B5 · New act session&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; queued question&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; engine for the GDPR (cached); new session with the same language and recent exchanges, plus a note that the act changed; answer from GDPR Article 83 with verified quotations; disclaimer not repeated" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1238" y="296" width="246" height="128" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="456" width="1740" height="172" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;C · Return to the Code&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;After answering from another act, the app goes back to the home act.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#BDBDBD;" vertex="1" parent="1"><mxGeometry x="32" y="470" width="146" height="144" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;C1 · After the answer · app.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; reply from the GDPR&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; return flag set: the next page draw goes back to the Code; the answer stays on screen" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="190" y="484" width="246" height="128" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;C2 · Topics log (only if needed)&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; subjects the answer depends on outside the library&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; recorded automatically for the author (90 days); the user is not asked" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="452" y="484" width="246" height="128" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;C3 · Return&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; return flag&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; dropdown set to the Code (NLI_DOCUMENT); language carried over; conversation kept; note “Back to European Electronic Communications Code for your next question”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="714" y="484" width="246" height="128" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;C4 · Home session&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; next question&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; new session in the Code with the language and recent exchanges carried over; follow-up questions keep their meaning; answered from the Code&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;NLI_RETURN_HOME=off keeps the other act selected&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="976" y="484" width="246" height="128" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;C5 · Usage log&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; each turn&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; one line per turn with act, language, kind of reply, articles; a new random session id per act session" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1238" y="484" width="246" height="128" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="answer given" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1361.0" y="448"/><mxPoint x="313.0" y="448"/></Array></mxGeometry></mxCell><mxCell id="c41" value="What carries over when the act changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="648" width="1100" height="175" as="geometry"/></mxCell><mxCell id="c42" value="&lt;table style='border-collapse:collapse;font-size:11px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;background:#F5F5F5'&gt;&lt;/th&gt;&lt;th style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;background:#F5F5F5'&gt;Switch to another act (B4)&lt;/th&gt;&lt;th style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;background:#F5F5F5'&gt;Return to the Code (C3)&lt;/th&gt;&lt;th style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;background:#F5F5F5'&gt;New conversation&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;&lt;b&gt;Language&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;kept&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;kept&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;browser's language&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;&lt;b&gt;Conversation on screen&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;kept, with a note&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;kept, with a note&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;cleared&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;&lt;b&gt;Disclaimer&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;not repeated&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;not repeated&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;shown again with the first reply&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;&lt;b&gt;History the model sees&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;recent exchanges + note “act changed”&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;recent exchanges + note “act changed”&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;starts again&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;&lt;b&gt;Selected act&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;the suggested act&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;the Code (home act)&lt;/td&gt;&lt;td style='border:1px solid #BDBDBD;padding:3px 8px;text-align:left;'&gt;unchanged&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1"><mxGeometry x="32" y="678" width="1076" height="135" as="geometry"/></mxCell><mxCell id="c43" value="Why it works this way" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="1140" y="648" width="620" height="175" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;One question, one act.&lt;/b&gt; Each answer comes from one act, so its quotations and links stay traceable. Switching and returning are explicit and noted in the conversation." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1152" y="678" width="290" height="130" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;The Code stays the default.&lt;/b&gt; Detours to other acts are one question long; lawyers testing the Code never get stuck in another act by accident." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1458" y="678" width="290" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>