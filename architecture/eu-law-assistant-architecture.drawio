<mxfile host="app.diagrams.net" agent="EU LexRef" version="24.7.0"><diagram id="prototype" name="1 · Prototype as built"><mxGraphModel dx="1760" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1030" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="EU LexRef — solution architecture (prototype as built)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#212121;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1300" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Inputs and outputs of each component · October 2026 · library: European Electronic Communications Code (home act), GDPR, BEREC Regulation · 24 EU languages · test version hosted on Streamlit Community Cloud from GitHub, password-protected" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1380" height="20" as="geometry"/></mxCell><mxCell id="c5" value="Users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="165" height="440" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Legal professional&lt;/b&gt;&lt;br&gt;web browser, any EU language; test password + disclaimer tick" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="32" y="125" width="140" height="72" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Author / tester&lt;/b&gt;&lt;br&gt;terminal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="32" y="385" width="140" height="45" as="geometry"/></mxCell><mxCell id="c8" value="Interfaces (Streamlit Cloud)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="200" y="80" width="230" height="440" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Web chat · app.py (Streamlit)&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; question, legal act (dropdown), example click, Switch&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; answer as it is written: key-finding summary, explanation, cited articles as linked labels, exact wording collapsed, one follow-up offer; notes when the act changes; page in the user's language" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="212" y="112" width="206" height="140" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Login page · app.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; password + tick: “reference assistant, not a legal advisor”&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; access to the chat; nothing loads or costs money before it&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;NLI_APP_PASSWORD from the Cloud's Secrets&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="212" y="260" width="206" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Terminal chat · cli.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; question, /acts, /switch&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; full answer as text" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="212" y="365" width="206" height="70" as="geometry"/></mxCell><mxCell id="c12" value="Conversation engine · engine.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="450" y="80" width="640" height="440" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1 · Analyse (model call)&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; message, history, act outline, library scopes&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; language, intent, in scope?, search queries, covering act" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="465" y="115" width="190" height="95" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;2 · Route · library.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; search queries, act named by step 1&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; suggestion only when that act also matches on keywords" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="670" y="115" width="190" height="95" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;3 · Retrieve (keyword search)&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; search queries&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; passages of the selected act, in the user's language" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="875" y="115" width="190" height="95" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;4 · Answer (model call)&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; passages + request + recent conversation&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; plain summary, explanation, follow-up offer, quotations, subjects outside the act&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;streamed word by word&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="875" y="235" width="190" height="105" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;5 · Verify quotations&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; proposed quotations&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; only those found word for word in the stored official text" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="670" y="235" width="190" height="105" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;6 · Finish&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; verified answer&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; reply parts, notes, source line, EUR-Lex links; disclaimer on the first reply only; closest provisions if not settled" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="465" y="235" width="190" height="105" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Localiser · i18n.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; conversation language&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; page texts, notices, act names, examples in 24 languages" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="465" y="360" width="190" height="95" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Topics &amp; suggestions&lt;/b&gt;&lt;br&gt;records subjects outside the act for the author automatically; suggests a better act (Switch); then returns to the home act, the Code" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="670" y="360" width="190" height="95" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Session&lt;/b&gt;&lt;br&gt;language · recent history · last follow-up offer · disclaimer shown · random id (no user identity)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="875" y="360" width="190" height="95" as="geometry"/></mxCell><mxCell id="c22" value="AI model gateway · llm.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="1110" y="80" width="280" height="440" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;LLM gateway&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; prompt + JSON schema; API key from .env or the Cloud's Secrets&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; structured JSON (streamed), token counts; busy / setup / other errors, detail to the server log" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1125" y="112" width="250" height="108" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Provider&lt;/b&gt; (NLI_PROVIDER)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#D79B00;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1125" y="230" width="250" height="165" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;default · API key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1137" y="255" width="226" height="38" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;your AWS account · EU region · IAM" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1137" y="300" width="226" height="38" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Microsoft Foundry&lt;/b&gt;&lt;br&gt;your Azure tenant · API key or Entra ID" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1137" y="345" width="226" height="38" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Claude Sonnet 5.5&lt;/b&gt;&lt;br&gt;JSON-schema output · effort: low · streaming" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1125" y="415" width="250" height="55" as="geometry"/></mxCell><mxCell id="c29" value="Knowledge store · documents/ and data/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="450" y="545" width="640" height="210" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Translations&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; English master wording&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; data/i18n/&amp;lt;lang&amp;gt;.json; reviewed entries kept" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="465" y="585" width="145" height="145" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Registry&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; --add-eurlex or a template&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; documents/&amp;lt;act&amp;gt;.json: source, scope, versions, examples" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="625" y="585" width="145" height="145" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Library index&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; English text of every act&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; one keyword index across acts, comparable scores" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="785" y="585" width="145" height="145" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Corpora&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; parsed provisions&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; one JSON file per act, version and language (3 acts × 24 languages) in data/corpus/" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="945" y="585" width="135" height="145" as="geometry"/></mxCell><mxCell id="c34" value="Ingestion &amp; updates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="450" y="780" width="640" height="225" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Ingest CLI · ingest.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; act id, CELEX, languages&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; built corpora; new registry file" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" parent="1"><mxGeometry x="465" y="820" width="145" height="140" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Parser · parser.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; XHTML / HTML / Markdown / text&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; articles, recitals, annexes, sections with paragraph numbers" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" parent="1"><mxGeometry x="625" y="820" width="145" height="140" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Live check · live.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; published versions, live text&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; adopts newer versions, rebuilds changed text through the source adapters, status" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" parent="1"><mxGeometry x="785" y="820" width="145" height="140" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Source adapters · sources.py&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; registry entry&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; raw text; links; newer versions&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;eurlex: CELEX, 24 languages · web: page or file&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" parent="1"><mxGeometry x="945" y="820" width="135" height="140" as="geometry"/></mxCell><mxCell id="c39" value="External sources (public)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBD