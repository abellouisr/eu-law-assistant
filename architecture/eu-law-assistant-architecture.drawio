="805"/><mxPoint x="880" y="805"/></Array></mxGeometry></mxCell><mxCell id="c89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c43" target="c38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="940"/><mxPoint x="1100" y="939"/></Array></mxGeometry></mxCell><mxCell id="c91" value="User-friendliness (as built)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="1410" y="80" width="330" height="925" as="geometry"/></mxCell><mxCell id="c92" value="&lt;b&gt;Key finding first.&lt;/b&gt; 1–2 sentence summary in a key-finding box, then a short explanation (&amp;lt;120 words); cited articles as linked labels; exact wording collapsed. If the act does not settle the point, it says so and lists the closest provisions." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1422" y="112" width="306" height="76" as="geometry"/></mxCell><mxCell id="c93" value="&lt;b&gt;Feels fast.&lt;/b&gt; Text appears word by word about 6 s after asking; full answer in ~9–10 s. Background checks never make users wait." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1422" y="196" width="306" height="76" as="geometry"/></mxCell><mxCell id="c94" value="&lt;b&gt;Your language.&lt;/b&gt; Whole page, answers, quotations and article names in 24 EU languages; before the first question, the browser's language." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1422" y="280" width="306" height="76" as="geometry"/></mxCell><mxCell id="c95" value="&lt;b&gt;Trustworthy.&lt;/b&gt; Every quotation verified word for word against the stored official text and linked to EUR-Lex; source line says when the text was last checked." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1422" y="364" width="306" height="76" as="geometry"/></mxCell><mxCell id="c96" value="&lt;b&gt;Finds the right act.&lt;/b&gt; A better act is suggested only when it covers the subject, with one-click “Switch … and ask there”; afterwards the app returns to the Code." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1422" y="448" width="306" height="76" as="geometry"/></mxCell><mxCell id="c97" value="&lt;b&gt;Natural and professional.&lt;/b&gt; One follow-up offer written for the question, never repeated; no Yes/No interruptions. Slim header, navy palette, coloured chat icons; red only for real errors." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1422" y="532" width="306" height="76" as="geometry"/></mxCell><mxCell id="c98" value="&lt;b&gt;Calm when things fail.&lt;/b&gt; Busy, setup and other errors each get a plain message; technical detail goes to the server log. Offline: keeps answering from the stored copy." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1422" y="616" width="306" height="76" as="geometry"/></mxCell><mxCell id="c99" value="&lt;b&gt;Transparent.&lt;/b&gt; Disclaimer accepted at login, then shown once per conversation. Questions and topics kept 90 days, nothing identifying recorded; author views terminal-only." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1422" y="700" width="306" height="76" as="geometry"/></mxCell><mxCell id="c100" value="&lt;b&gt;Gap:&lt;/b&gt; Shared test password only, no personal sign-in or roles; logs on the free host reset when it restarts." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FDECEA;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1422" y="785" width="306" height="66" as="geometry"/></mxCell><mxCell id="c101" value="&lt;b&gt;Gap:&lt;/b&gt; Keyword search: may miss paraphrased questions; answers come from one act at a time." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FDECEA;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1422" y="857" width="306" height="66" as="geometry"/></mxCell><mxCell id="c102" value="&lt;b&gt;Gap:&lt;/b&gt; 58 automated tests cover behaviour, not legal accuracy: no measured test set yet; translations machine-made, need review." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FDECEA;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1422" y="929" width="306" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="target" name="2 · Target production design"><mxGraphModel dx="1780" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1090" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="EU LexRef — target production design for a large professional services firm" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#212121;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1500" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Layered architecture in the firm's own cloud (AWS or Azure) · inputs and outputs per component · feasibility notes on the right" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#616161;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1500" height="20" as="geometry"/></mxCell><mxCell id="c5" value="Channels: where lawyers already work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1130" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; question, act, as-at date&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; streamed answer, citations&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;accessible, 24 languages&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="35.0" y="110" width="260.0" height="78" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Microsoft Teams / Copilot&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; question in chat&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; answer card with citations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="315.0" y="110" width="260.0" height="78" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Firm's internal AI platform&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; tool call&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; grounded answer + sources&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;plug-in, not a new destination&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="595.0" y="110" width="260.0" height="78" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;REST API&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; JSON request&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; JSON answer&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;for other internal systems&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="875.0" y="110" width="260.0" height="78" as="geometry"/></mxCell><mxCell id="c10" value="Identity &amp; edge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="225" width="1130" height="105" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Single sign-on&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; user&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; Entra ID / Okta token; roles by practice group" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="35.0" y="255" width="353.3333333333333" height="63" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;API gateway &amp; WAF&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; request + token&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; authorised request; rate limits, quotas" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="408.3333333333333" y="255" width="353.3333333333333" height="63" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Data protection filter&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; question&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; question with client identifiers flagged or masked" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="781.6666666666666" y="255" width="353.3333333333333" height="63" as="geometry"/></mxCell><mxCell id="c14" value="Application services · containers with autoscaling (ECS/EKS or AKS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="355" width="1130" height="150" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Chat API &amp; sessions&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; authorised request&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; conversation state (DB), streamed events" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="35.0" y="385" width="204.0" height="108" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; question&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; analyse → route → retrieve → answer → verify" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="259.0" y="385" width="204.0" height="108" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Act router&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; question&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; relevant acts; answers spanning several acts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="483.0" y="385" width="204.0" height="108" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Citation verifier&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; draft answer&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; quotations and article numbers checked against the source" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="707.0" y="385" width="204.0" height="108" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Localisation&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; language&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; reviewed wording in 24 languages" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="931.0" y="385" width="204.0" height="108" as="geometry"/></mxCell><mxCell id="c20" value="AI platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1130" height="125" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Claude via Bedrock or Foundry&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; prompt + schema&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; structured, streamed answer&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;EU region, firm tenant, zero retention terms&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="35.0" y="560" width="260.0" height="83" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Prompt caching &amp; cost control&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; repeated act text&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; lower cost and latency; budgets per team" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="315.0" y="560" width="260.0" height="83" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Evaluation suite&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; test questions per act&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; accuracy, citation and scope scores on every change" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="595.0" y="560" width="260.0" height="83" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Safety &amp; refusal handling&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; model output&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; safe fallback message, logged event" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="875.0" y="560" width="260.0" height="83" as="geometry"/></mxCell><mxCell id="c25" value="Knowledge platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1130" height="125" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Document registry (Postgres)&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; approved sources&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; acts, versions, scope, owners" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="35.0" y="710" width="260.0" height="83" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Hybrid search&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; question&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; passages by keywords + meaning&lt;br&gt;&lt;i&gt;&lt;font color='#757575'&gt;OpenSearch / Azure AI Search / pgvector&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="315.0" y="710" width="260.0" height="83" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Versioned text store&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; parsed texts&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; law as at any date (S3 / Blob)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="595.0" y="710" width="260.0" height="83" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Translation store&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; English wording&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; reviewed translations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="875.0" y="710" width="260.0" height="83" as="geometry"/></mxCell><mxCell id="c30" value="Ingestion &amp; content governance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="1130" height="140" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Scheduler &amp; job queue&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; timer, new source&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; ingest and update jobs (SQS / Service Bus)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" parent="1"><mxGeometry x="35.0" y="860" width="260.0" height="98" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Source adapters&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; EUR-Lex/Cellar, national gazettes (N-Lex), CJEU case law, regulators' guidance, internal know-how&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; parsed provisions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" parent="1"><mxGeometry x="315.0" y="860" width="260.0" height="98" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Expert review &amp; approval&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; new act or changed text&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; approved version goes live" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" p