=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="c17" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="690"/><mxPoint x="445" y="690"/></Array></mxGeometry></mxCell><mxCell id="c40" value="Governance &amp; operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="1170" y="80" width="270" height="890" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Immutable audit log&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; every request and answer&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; SIEM; tamper-evident, retention by policy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="115" width="246" height="105" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Usage &amp; quality dashboards&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; logs, evaluation scores&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; adoption, accuracy, cost per team" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="235" width="246" height="105" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Privacy &amp; compliance&lt;/b&gt;&lt;br&gt;DPIA, data residency, ISO 27001 / SOC 2 controls, EU AI Act transparency duties" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="355" width="246" height="105" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Content ownership&lt;/b&gt;&lt;br&gt;named owner per act; translations and scope reviewed by legal experts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="475" width="246" height="105" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Professional risk&lt;/b&gt;&lt;br&gt;“reference, not advice” positioning agreed with risk &amp; quality; human review of client deliverables" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="595" width="246" height="105" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Cost &amp; capacity&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; usage per team&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; budgets, quotas, alerts; prompt-caching savings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="715" width="246" height="105" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Release management&lt;/b&gt;&lt;br&gt;&lt;font color='#616161'&gt;In:&lt;/font&gt; prompt, model or search change&lt;br&gt;&lt;font color='#616161'&gt;Out:&lt;/font&gt; evaluation gate before release; one-click rollback" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1182" y="835" width="246" height="105" as="geometry"/></mxCell><mxCell id="c48" value="Feasibility &amp; roadmap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="1460" y="80" width="300" height="890" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Foundation is proven.&lt;/b&gt; Grounded answers with verified quotations, 24 languages, automatic updates, 3 acts, Bedrock/Foundry-ready: the core approach works." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#E8F5E9;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1472" y="112" width="276" height="84" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Biggest technical gap.&lt;/b&gt; Search and answers across hundreds of acts: hybrid search, multi-act answers, law as at a date." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1472" y="204" width="276" height="84" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Decisive for a Big 4 firm.&lt;/b&gt; Confidential client facts will be typed in: run in the firm's tenant, SSO, audit, zero-retention terms." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1472" y="296" width="276" height="84" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Sign-off needs numbers.&lt;/b&gt; Measured accuracy per act (evaluation suite) before risk &amp; quality functions approve." style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1472" y="388" width="276" height="84" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Prototype · done&lt;/b&gt;&lt;br&gt;3 acts, verified quotations, 24 languages, cross-act suggestions, live updates, usage &amp; consent logs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#5E35B1;" vertex="1" parent="1"><mxGeometry x="1472" y="500" width="276" height="120" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Pilot · ~3–4 months&lt;/b&gt;&lt;br&gt;5–10 acts for one practice group; SSO; firm cloud; evaluation suite; Teams plug-in. 2–3 engineers + legal expert part-time" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" parent="1"><mxGeometry x="1472" y="650" width="276" height="120" as="geometry"/></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Production · ~9–12+ months&lt;/b&gt;&lt;br&gt;hundreds of acts; hybrid search; multi-act answers; law as at a date; full compliance; dedicated product team" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;arcSize=5;fontFamily=Helvetica;fillColor=#D4EEEC;strokeColor=#2A9D8F;" vertex="1" parent="1"><mxGeometry x="1472" y="800" width="276" height="120" as="geometry"/></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#616161;fontSize=9;fontColor=#424242;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c54" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="Effort figures are indicative and depend on the firm's existing platform." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#757575;" vertex="1" parent="1"><mxGeometry x="1472" y="932" width="276" height="30" as="geometry"/></mxCell><mxCell id="c59" value="User-friendliness in the target design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=2;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="20" y="995" width="1740" height="75" as="geometry"/></mxCell><mxCell id="c60" value="Ask from Teams or the firm's AI platform: no new tool to learn" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="32" y="1025" width="330" height="36" as="geometry"/></mxCell><mxCell id="c61" value="Single sign-on: no extra password" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="377" y="1025" width="330" height="36" as="geometry"/></mxCell><mxCell id="c62" value="“As at” date selector for historic law" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="722" y="1025" width="330" height="36" as="geometry"/></mxCell><mxCell id="c63" value="Answers across several acts, each citation verified" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1067" y="1025" width="330" height="36" as="geometry"/></mxCell><mxCell id="c64" value="Same plain-summary-first answers, in 24 languages" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;spacingRight=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1412" y="1025" width="330" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>